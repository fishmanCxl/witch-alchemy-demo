{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "witch-water-sort/progress.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "revision", "currentLevel", "highestUnlockedLevel", "completedLevels", "bestMoves", "configVersion"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "revision": { "type": "integer", "minimum": 0 },
    "currentLevel": { "type": "string", "pattern": "^level-[0-9]{3}$" },
    "highestUnlockedLevel": { "type": "string", "pattern": "^level-[0-9]{3}$" },
    "completedLevels": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^level-[0-9]{3}$" }
    },
    "bestMoves": {
      "type": "object",
      "propertyNames": { "pattern": "^level-[0-9]{3}$" },
      "additionalProperties": { "type": "integer", "minimum": 1 }
    },
    "configVersion": { "type": "string", "maxLength": 64 }
  }
}
